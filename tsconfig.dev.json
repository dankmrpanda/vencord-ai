{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react",
    "jsxFactory": "React.createElement",
    "jsxFragmentFactory": "React.Fragment",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@/*": ["./*"],
      "@webpack": ["./test/mocks/vencord.ts"],
      "@webpack/common": ["./test/mocks/vencord.ts"],
      "@api/Settings": ["./test/mocks/vencord.ts"],
      "@utils/types": ["./test/mocks/vencord.ts"],
      "@utils/constants": ["./test/mocks/vencord.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
